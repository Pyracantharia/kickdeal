#pour la bdd
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

#pour symfony
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?serverVersion=15&charset=utf8"

# Mercure / SSE
MERCURE_JWT_SECRET=


# Variables pour Traefik (Backend API)
TRAEFIK_ROUTER_NAME=nom-backend
TRAEFIK_DOMAIN=api.mondomaine.site
TRAEFIK_CERTRESOLVER=letsencrypt

# Variables pour Traefik (Frontend)
TRAEFIK_FRONTEND_ROUTER_NAME=nom-frontend
TRAEFIK_FRONTEND_DOMAIN=mondomaine.site

# Variables pour Traefik (Frontend App)
TRAEFIK_FRONTEND_APP_ROUTER_NAME=nom-frontend-app
TRAEFIK_FRONTEND_APP_DOMAIN=app.kickdeal.site

# Variables pour Symfony / CORS
FRONTEND_URL=https://${TRAEFIK_FRONTEND_APP_DOMAIN}
CORS_ALLOW_ORIGIN='^https://app\.mondomaine\.site$'

# Variables pour Chiliz Spicy Testnet
CHILIZ_RPC_URL=https://spicy-rpc.chiliz.com/
CHILIZ_CHAIN_ID=88882
CHILIZ_RECEIVER_ADDRESS=adresse_wallet_kickdeal
CHZ_EUR_RATE=200

# Variables publiques frontend app pour Chiliz Spicy Testnet
NEXT_PUBLIC_CHILIZ_CHAIN_ID=88882
NEXT_PUBLIC_CHILIZ_RPC_URL=https://spicy-rpc.chiliz.com/
NEXT_PUBLIC_CHILIZ_RECEIVER_ADDRESS=adresse_wallet_kickdeal
NEXT_PUBLIC_CHZ_EUR_RATE=200

# Stripe — la clé secrète et le secret du webhook restent uniquement côté backend.
# Créez un Price mensuel récurrent dans Stripe pour chaque plan payant.
STRIPE_SECRET=sk_test_...
STRIPE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_AGENT_PRO=price_...
STRIPE_PRICE_CLUB_PRO=price_...
STRIPE_PRICE_CLUB_ENTERPRISE=price_...
