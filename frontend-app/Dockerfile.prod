FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install 
COPY . .

# Variables Next.js requises au moment du build
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_MERCURE_URL
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_CHILIZ_CHAIN_ID
ARG NEXT_PUBLIC_CHILIZ_RPC_URL
ARG NEXT_PUBLIC_CHILIZ_RECEIVER_ADDRESS
ARG NEXT_PUBLIC_CHZ_EUR_RATE
ARG NEXT_PUBLIC_LANDING_URL

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_MERCURE_URL=$NEXT_PUBLIC_MERCURE_URL
ENV NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_CHILIZ_CHAIN_ID=$NEXT_PUBLIC_CHILIZ_CHAIN_ID
ENV NEXT_PUBLIC_CHILIZ_RPC_URL=$NEXT_PUBLIC_CHILIZ_RPC_URL
ENV NEXT_PUBLIC_CHILIZ_RECEIVER_ADDRESS=$NEXT_PUBLIC_CHILIZ_RECEIVER_ADDRESS
ENV NEXT_PUBLIC_CHZ_EUR_RATE=$NEXT_PUBLIC_CHZ_EUR_RATE
ENV NEXT_PUBLIC_LANDING_URL=$NEXT_PUBLIC_LANDING_URL

RUN npm run build

FROM node:22-alpine
WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

RUN addgroup -g 1001 -S nodejs
RUN adduser -S next -u 1001
RUN chown -R next:nodejs /app
USER next

EXPOSE 3000

CMD ["node", "server.js"]
